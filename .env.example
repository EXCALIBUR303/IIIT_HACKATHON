# RupeeRise environment template. Copy to `.env` (never commit real values).
# Used by docker-compose. For local development without Docker, copy
# backend/.env.example -> backend/.env and frontend/.env.example -> frontend/.env.

POSTGRES_USER=rupeerise
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=rupeerise

# Backend (all variables use the RUPEERISE_ prefix)
RUPEERISE_ENV=development
RUPEERISE_SECRET_KEY=generate-with-python-secrets-token-urlsafe-48
# Organisations and educator invitations are created by an operator, never through the web app:
#   docker compose exec api uv run --no-sync python -m app.admin create-org "Your NGO"
#   docker compose exec api uv run --no-sync python -m app.admin create-invite --org "Your NGO"
# Origins allowed to call the API with cookies (also used for the CSRF Origin check).
RUPEERISE_CORS_ORIGINS=["http://localhost:8080"]
# Local HTTP only. Never set false in production.
RUPEERISE_COOKIE_SECURE=false
RUPEERISE_ENABLE_API_DOCS=false
# Folder holding answer_keys.json (not in git). Mounted read-only into the API container.
PRIVATE_CONTENT_HOST_DIR=./backend/private_content
# Optional AI tutor. Leave empty to use deterministic explanations only.
RUPEERISE_ANTHROPIC_API_KEY=
# Market Lab reference data (server-side only; never exposed to the browser).
# Empty = clearly labelled demo prices and explainers.
ALPHA_VANTAGE_API_KEY=
MARKETAUX_API_TOKEN=
