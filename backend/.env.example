# Copy to backend/.env for local development. Never commit backend/.env.
RUPEERISE_ENV=development
RUPEERISE_DATABASE_URL=postgresql+psycopg://localhost:5432/rupeerise
# Required in production (generate: python -c "import secrets; print(secrets.token_urlsafe(48))")
RUPEERISE_SECRET_KEY=dev-only-insecure-secret-change-me
RUPEERISE_ACCESS_TOKEN_MINUTES=720
RUPEERISE_CORS_ORIGINS=["http://localhost:5173"]
# Educators must enter this code to register. Required (non-default) in production.
RUPEERISE_EDUCATOR_INVITE_CODE=dev-educator-invite
# Optional AI tutor (install with: uv sync --group ai). Empty = deterministic fallback.
RUPEERISE_ANTHROPIC_API_KEY=
RUPEERISE_TUTOR_MODEL=claude-opus-5-5
RUPEERISE_TUTOR_EFFORT=low
