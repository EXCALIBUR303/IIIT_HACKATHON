# Copy to backend/.env for local development. Never commit backend/.env.
RUPEERISE_ENV=development
RUPEERISE_DATABASE_URL=postgresql+psycopg://localhost:5432/rupeerise
# Required in production (generate: python -c "import secrets; print(secrets.token_urlsafe(48))")
RUPEERISE_SECRET_KEY=dev-only-insecure-secret-change-me
# Access sessions are short; a refresh cookie (rotated on every use) keeps people signed in.
RUPEERISE_ACCESS_TOKEN_MINUTES=15
RUPEERISE_REFRESH_DAYS=14
RUPEERISE_CORS_ORIGINS=["http://localhost:5173"]
# Educators join only with an organisation-bound, expiring invitation created by an operator:
#   uv run python -m app.admin create-org "Your NGO"
#   uv run python -m app.admin create-invite --org "Your NGO" --days 7 --uses 1
# Cookies are Secure in production. For plain-HTTP localhost development they are not.
RUPEERISE_COOKIE_SECURE=false
# Interactive API docs at /api/docs (development only; always off in production).
RUPEERISE_ENABLE_API_DOCS=true
# Answer keys live outside git. Point at the folder with answer_keys.json. Production
# refuses to start without it; development falls back to labelled placeholders.
# RUPEERISE_PRIVATE_CONTENT_DIR=./private_content
# Per-IP / per-account abuse limits (Postgres-backed). Defaults are in app/core/config.py.
# RUPEERISE_RATE_LIMIT_ENABLED=true
# Optional AI tutor (install with: uv sync --group ai). Empty = deterministic fallback.
RUPEERISE_ANTHROPIC_API_KEY=
RUPEERISE_TUTOR_MODEL=claude-opus-5-5
RUPEERISE_TUTOR_EFFORT=low
# Market Lab reference data (server-side only; never exposed to the browser).
# Empty = clearly labelled demo prices and explainers.
ALPHA_VANTAGE_API_KEY=
MARKETAUX_API_TOKEN=
